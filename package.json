{
  "name": "natural",
  "private": true,
  "version": "0.0.1",
  "description": "A modern-day society and economy simulation game",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @natural/ui",
    "test": "vitest run",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/cli --noEmit && tsc -p packages/ui --noEmit",
    "sim": "npm run sim -w @natural/cli",
    "ui": "npm run dev -w @natural/ui",
    "check:boundary": "node scripts/check-boundary.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
