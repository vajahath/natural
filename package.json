{
  "name": "natural",
  "private": true,
  "version": "0.0.1",
  "description": "A modern-day society and economy simulation game",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @natural/engine",
    "test": "vitest run",
    "typecheck": "tsc -b packages/engine packages/cli",
    "sim": "npm run sim -w @natural/cli",
    "ui": "npm run dev -w @natural/ui",
    "check:boundary": "node scripts/check-boundary.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0"
  }
}
